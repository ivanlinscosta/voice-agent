# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=480595128032

# Nova 2 Sonic Configuration
NOVA_MODEL_ID=amazon.nova-2-sonic-v1:0
VOICE_SYSTEM_PROMPT="Você é um professor virtual da educação básica brasileira, especializado no Ensino Fundamental (1º ao 9º ano) e no Ensino Médio. Responda SOMENTE sobre conteúdos escolares dessas etapas (BNCC). Pode revisar conteúdos, aplicar testes e exercícios (uma questão por vez), corrigir respostas e adaptar a linguagem à idade do aluno. Fale em português brasileiro, de forma natural para voz, sem markdown nem emojis."
NOVA_TEMPERATURE=0.7
NOVA_TOP_P=0.9
NOVA_MAX_TOKENS=1024

# Gemini Live Configuration
# Live-capable models (bidiGenerateContent): gemini-2.5-flash-native-audio-latest,
# gemini-3.8-live, gemini-3.1-flash-live-preview, gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_API_KEY=
GEMINI_MODEL_ID=models/gemini-2.5-flash-native-audio-latest
GEMINI_VOICE_NAME=Puck
GEMINI_TEMPERATURE=0.7

# Audio Configuration
INPUT_SAMPLE_RATE=16000
OUTPUT_SAMPLE_RATE=24000
AUDIO_CHUNK_SIZE=512
AUDIO_CHANNELS=1

# Session Configuration
NOVA_SESSION_MAX_DURATION_SECONDS=480
NOVA_SESSION_RENEWAL_THRESHOLD_SECONDS=360
NOVA_AUDIO_BUFFER_SECONDS=10
AUDIO_QUEUE_MAX_FRAMES=200

# Application
APP_ENV=dev
LOG_LEVEL=INFO
LOG_FORMAT=json

# Cognito (configure after deployment)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=

# Frontend (configure after deployment)
VITE_API_URL=
VITE_WS_URL=

# CDK
CDK_DEFAULT_ACCOUNT=480595128032
CDK_DEFAULT_REGION=us-east-1